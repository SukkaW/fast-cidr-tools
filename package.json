{
  "name": "fast-cidr-tools",
  "version": "0.3.4",
  "description": "cidr-tools but up to 20x faster",
  "homepage": "https://github.com/SukkaW/fast-cidr-tools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SukkaW/fast-cidr-tools.git"
  },
  "bugs": {
    "url": "https://github.com/SukkaW/fast-cidr-tools/issues"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/es/index.mjs",
  "types": "./dist/cjs/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/es/index.d.mts",
        "default": "./dist/es/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint --format=sukka .",
    "build": "bunchee --clean --target=es2021",
    "test": "mocha --require @swc-node/register test/index.test.ts",
    "benchmark": "SWC_NODE_IGNORE_DYNAMIC=1 node -r @swc-node/register benchmark.cts",
    "prepublishOnly": "rimraf dist && npm run test && npm run build",
    "prerelease": "pnpm run lint && pnpm run test && pnpm run build",
    "release": "bumpp -r --all --commit \"release: %s\" --tag \"%s\""
  },
  "keywords": [
    "cidr",
    "ip",
    "ipv4"
  ],
  "author": "Sukka <https://skk.moe>",
  "license": "MIT",
  "dependencies": {
    "foxts": "^5.9.1"
  },
  "devDependencies": {
    "@eslint-sukka/node": "^9.0.1",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.1",
    "@types/mocha": "^10.0.10",
    "bumpp": "^10.4.1",
    "bunchee": "^6.12.2",
    "cidr-tools": "^12.1.3",
    "cidr-tools-wasm": "^0.0.14",
    "earl": "^2.0.0",
    "eslint": "^10.8.1",
    "eslint-config-sukka": "^9.0.1",
    "eslint-formatter-sukka": "^9.0.1",
    "mitata": "^1.0.34",
    "mocha": "^11.8.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=16"
  }
}
